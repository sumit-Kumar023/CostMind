# Copy to .env and fill in. Comments must be on their own lines (an inline "# ..." after a value becomes part of the value).

APP_ENV=dev
LOG_LEVEL=INFO

# --- LLM providers (never commit real keys). With neither key set, an offline mock LLM is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model tiers (any LiteLLM model string)
CHEAP_MODEL=gpt-4o-mini
MID_MODEL=gpt-4o-mini
PREMIUM_MODEL=gpt-4o
# Comma-separated models tried when a provider call fails, e.g. claude-3-5-haiku-latest
FALLBACK_MODELS=

# --- Vector DB and Redis (local Docker by default). Use QDRANT_URL=:memory: and REDIS_URL=memory to run with no Docker.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379

# --- Providers: auto = real service if an API key is set, otherwise the offline fallback
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto
LLM_PROVIDER=auto

# --- Memory
SHORT_TERM_WINDOW=6
MEMORY_TOP_K=5
MEMORY_ANSWER_THRESHOLD=0.5
MIN_RECALL_SIMILARITY=0.2

# --- Routing
CONFIDENCE_THRESHOLD=0.75
MAX_TOKENS_PER_REQUEST=4000

# --- Budgets (USD)
MAX_USD_PER_REQUEST=0.05
MAX_USD_PER_USER_PER_DAY=0.50
MAX_USD_GLOBAL_PER_DAY=2.0
LOW_BUDGET_FRACTION=0.2

# --- Cache
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=24
MEMORY_SHORTCUT_ENABLED=true

# --- Analytics database file
ANALYTICS_DB=costmind.db

# --- Security. Leave API_KEY empty for local use; set it in production (clients then send header X-API-Key).
API_KEY=
WARMUP=true
